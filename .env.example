# OpenAI
OPENAI_API_KEY=sk-...

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Ollama runs locally on http://localhost:11434 by default; no key required.
# Required for: Llama 3.1 8B (llama3.1:latest), Gemma 3 12B (gemma3:12b).

# --- Gemini provider (optional, only if you use --provider gemini) ---
# Choose ONE of the two authentication modes below.
#
# Mode 1: Public Gemini API (simpler; recommended for quick reproduction).
# GEMINI_API_KEY=...
#
# Mode 2: Vertex AI via a Google Cloud service account.
# Create a service account in your GCP project, download its JSON key, save
# it OUTSIDE the repo (or under ./secrets/ which is gitignored), then set:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1   # optional; defaults to us-central1
#
# NEVER commit a real service-account JSON. The .gitignore in this repo
# excludes secrets/ and common service-account filename patterns.
